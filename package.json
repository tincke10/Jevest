{
  "name": "jevest",
  "version": "0.1.0",
  "private": true,
  "description": "Automated PR review pipeline using Jev (TypeSafe AI) as a decision layer over an LLM reviewer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "spike": "tsx scripts/spike/run.ts",
    "spike:profile": "tsx scripts/spike/run-profile.ts",
    "profile:label": "tsx scripts/profile/label.ts",
    "filter": "tsx scripts/filter/run.ts",
    "calibrate": "tsx scripts/filter/calibrate.ts",
    "findings": "tsx scripts/findings/generate.ts",
    "findings:label": "tsx scripts/findings/label.ts",
    "action": "tsx src/action/main.ts",
    "review": "tsx scripts/review/run.ts",
    "dataset:prs": "tsx scripts/dataset/collect-prs.ts",
    "dataset:pairs": "tsx scripts/dataset/generate-pairs.ts",
    "dataset:evidence": "tsx scripts/dataset/collect-evidence.ts",
    "dataset:reverse": "tsx scripts/dataset/reverse-hunks.ts",
    "coherence:summarize": "tsx scripts/coherence/summarize.ts",
    "coherence": "tsx scripts/coherence/run.ts",
    "adversarial": "tsx scripts/adversarial/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@octokit/rest": "^21.1.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "openai": "^7.19.0",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.14.0",
    "@types/picomatch": "^4.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"]
  },
  "packageManager": "pnpm@10.29.3"
}
